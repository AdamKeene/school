# a.
fit = glm(default ~ income + balance, data = Default, family = "binomial")
summary(fit)
# b
boot.fn <- function(db, sample) {
fit <- glm(default ~ income + balance, data = db[sample, ], family = "binomial")
coef(fit)[-1]
}
boot.fn
boot.fn
# c.
boot(Default, boot.fn, R = 1000)
# c.
boot(Default, boot.fn, R = 1000)
